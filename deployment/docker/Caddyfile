http://retroinsight.aksa.com.tr {
	redir https://retroinsight.aksa.com.tr{uri} permanent
}

https://retroinsight.aksa.com.tr {
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem {
		protocols tls1.2 tls1.3
	}

	log {
		output stdout
	}

	@api {
		path /api*
	}
	reverse_proxy @api aksa-backend:{$AKSA_SERVER_PORT}

	@frontend {
		path / /static* /locales* /login* /board* /new* /timer_finished.mp3 /hotkeys.pdf /manifest.json /service-worker.js /emoji-data/* /aksa-logo* /favicon*
	}
	reverse_proxy @frontend aksa-frontend:{$AKSA_LISTEN_PORT}
}
